.config/fish/*
!.config/fish/config.fish
!.config/fish/custom
!.config/fish/fish_plugins
!.config/fish/fisher-init.fish

# lazygit runtime state
Library/Application Support/lazygit/state.yml
Library/Application Support/lazygit/github_pull_requests.json

# mise local overrides
config.local.toml
mise.local.toml

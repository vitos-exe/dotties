**/.DS_Store

# nvim
dotfiles/.config/nvim/plugin
dotfiles/.config/nvim/lazy-lock.json

# fish (plugin-managed files are reinstalled by fisher)
dotfiles/.config/fish/*
!dotfiles/.config/fish/config.fish
!dotfiles/.config/fish/custom
!dotfiles/.config/fish/fish_plugins
!dotfiles/.config/fish/fisher-init.fish

# lazygit runtime state
dotfiles/Library/Application Support/lazygit/state.yml
dotfiles/Library/Application Support/lazygit/github_pull_requests.json

# mise local overrides
config.local.toml
mise.local.toml

**/.DS_Store

# nvim
home/.config/nvim/plugin
home/.config/nvim/lazy-lock.json

# fish (plugin-managed files are reinstalled by fisher)
home/.config/fish/*
!home/.config/fish/config.fish
!home/.config/fish/custom
!home/.config/fish/fish_plugins
!home/.config/fish/fisher-init.fish

# lazygit runtime state
home/Library/Application Support/lazygit/state.yml
home/Library/Application Support/lazygit/github_pull_requests.json

# mise local overrides
config.local.toml
mise.local.toml
